# Copy to .env beside compose.yaml, readable by its owner alone (chmod 600), and
# never commit it.

# SQL Server asks for upper and lower case, digits and a symbol.
SQL_SA_PASSWORD=
SQL_APP_PASSWORD=

# At least 32 characters.
JWT_SECRET_KEY=

# Where the frontend is served from, which the emailed links and passkeys use.
FRONTEND_BASE_URL=

# The SMTP server, and the address emails are sent from.
EMAIL_HOST=
EMAIL_SENDER=
