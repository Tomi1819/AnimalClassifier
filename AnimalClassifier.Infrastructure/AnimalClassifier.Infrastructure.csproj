<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AnimalClassifier.Core\AnimalClassifier.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.ML" />
    <PackageReference Include="Microsoft.ML" />
    <!-- The model is an image classification model, which is loaded by
         Vision and run by TensorFlow, whose native libraries the redist holds. -->
    <PackageReference Include="Microsoft.ML.Vision" />
    <PackageReference Include="SciSharp.TensorFlow.Redist" />
    <!-- A runtime for each platform the app runs on. Linux's is the full one
         rather than the slim, which cannot read videos. -->
    <PackageReference Include="OpenCvSharp4" />
    <PackageReference Include="OpenCvSharp4.runtime.win" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" />
  </ItemGroup>

</Project>
