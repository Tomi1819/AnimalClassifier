root = true

# The conventions the code is written in, so that the IDE follows them when it
# writes code itself, such as a new file or an added using. They are
# suggestions rather than warnings, and leave the build alone.

[*]
indent_style = space

[*.{csproj,props,json}]
indent_size = 2

[*.cs]
indent_size = 4

# Namespaces in blocks, with the usings inside them, sorted as they read
# rather than with System first.
csharp_style_namespace_declarations = block_scoped:suggestion
csharp_using_directive_placement = inside_namespace:suggestion
dotnet_sort_system_directives_first = false

dotnet_diagnostic.IDE0005.severity = suggestion

# EF Core writes the migrations, so they are left as it wrote them rather than
# held to the conventions above.
[**/Migrations/*.cs]
generated_code = true
