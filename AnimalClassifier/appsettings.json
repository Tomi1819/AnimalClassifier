{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://animalclassifier.app",
    "Audience": "https://animalclassifier.app",
    "ExpirationHours": 8
  },
  "FileUploadSettings": {
    "UploadPath": "App_Data/uploads"
  },
  "MLModel": {
    "Path": "MLModel.mlnet"
  },
  "Frontend": {
    "BaseUrl": "",
    "ResetPasswordPath": "/pages/reset-password.html",
    "ConfirmEmailPath": "/pages/confirm-email.html"
  },
  "Passkey": {
    "ServerDomain": ""
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "SenderEmail": "",
    "SenderName": "Animal Classifier"
  },
  "RateLimiting": {
    "LoginPermitLimit": 10,
    "LoginWindowMinutes": 15,
    "RegisterPermitLimit": 10,
    "RegisterWindowMinutes": 60,
    "PasswordConfirmationPermitLimit": 10,
    "PasswordConfirmationWindowMinutes": 15,
    "PasswordResetPermitLimit": 10,
    "PasswordResetWindowMinutes": 15,
    "DataExportPermitLimit": 3,
    "DataExportWindowMinutes": 15,
    "ConfirmationEmailPermitLimit": 3,
    "ConfirmationEmailWindowMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Admin": {
    "Email": ""
  }
}
