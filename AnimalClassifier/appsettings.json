  },
  "Passkey": {
    "ServerDomain": ""
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "SenderEmail": "",
    "SenderName": "Animal Classifier"
  },
  "RateLimiting": {
    "PasswordResetPermitLimit": 10,
    "PasswordResetWindowMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Admin": {
    "Email": ""
  }
