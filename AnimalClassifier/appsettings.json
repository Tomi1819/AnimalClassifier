{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://animalclassifier.app",
    "Audience": "https://animalclassifier.app",
    "ExpirationHours": 8
  },
  "FileUploadSettings": {
    "UploadPath": "App_Data/uploads",
    "RequestPath": "/uploads"
  },
  "MLModel": {
    "Path": "MLModel.mlnet"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
